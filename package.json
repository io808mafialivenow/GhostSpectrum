{
  "name": "ghostspectrum",
  "version": "1.0.0",
  "description": "GhostSpectrum: Sci-fi Electron-based terminal dashboard & system HUD (eDEX-UI revival fork)",
  "main": "src/_boot.js",
  "scripts": {
    "start": "electron . --nointro",
    "start:full": "electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/io808mafialivenow/GhostSpectrum.git"
  },
  "keywords": [
    "terminal",
    "hud",
    "sci-fi",
    "edex-ui",
    "electron",
    "android",
    "adb",
    "heimdall",
    "rubber-ducky"
  ],
  "author": "Devin Lane Jones <io808mafialivenow>",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/io808mafialivenow/GhostSpectrum/issues"
  },
  "homepage": "https://github.com/io808mafialivenow/GhostSpectrum#readme",
  "dependencies": {
    "node-pty": "^1.0.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0",
    "systeminformation": "^5.21.0"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.ghostspectrum.terminal",
    "productName": "GhostSpectrum",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "media/**/*",
      "file-icons/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "System"
    },
    "mac": {
      "target": ["dmg"]
    }
  }
}
